// pstview resources: application icon ("Sealed Signal" mark, see design/)
// PSTVIEW_VERSION_NUM / PSTVIEW_VERSION_STR are defined by build.zig.
1 ICON "../design/pstview.ico"

1 VERSIONINFO
FILEVERSION PSTVIEW_VERSION_NUM
PRODUCTVERSION PSTVIEW_VERSION_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "publicarray"
      VALUE "FileDescription", "pstview - read-only PST viewer and exporter"
      VALUE "FileVersion", PSTVIEW_VERSION_STR
      VALUE "ProductName", "pstview"
      VALUE "ProductVersion", PSTVIEW_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
