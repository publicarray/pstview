{
  "name": "pstview",
  "short_name": "pstview",
  "description": "Read-only viewer and exporter for Outlook PST / OST and MBOX mailboxes. Runs in the browser; nothing is uploaded.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#13233F",
  "theme_color": "#13233F",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.ms-outlook-pst": [".pst", ".ost"],
        "application/mbox": [".mbox", ".mbx"]
      }
    }
  ]
}
